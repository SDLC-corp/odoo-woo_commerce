<odoo>

<record id="view_product_template_form_woo" model="ir.ui.view">
    <field name="name">product.template.form.woo</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">

        <!-- ========================= -->
        <!-- HEADER BUTTONS -->
        <!-- ========================= -->
        <xpath expr="//form" position="attributes">
            <attribute name="create">false</attribute>
        </xpath>

        <!-- Buttons: parent view may not have a header; insert into the sheet instead -->
        <xpath expr="//sheet" position="inside">
            <group name="woo_buttons_group" colspan="4">
                <button name="action_woo_create"
                        string="Export / Update to Woo"
                        type="object"
                        class="btn-primary"/>

                <button name="action_manual_import_from_woo"
                        string="Import from Woo"
                        type="object"
                        class="btn-secondary"
                        invisible="not woo_product_id"/>

                <button name="action_manual_preview_from_woo"
                        string="Preview Sync"
                        type="object"
                        class="btn-secondary"
                        invisible="not woo_product_id"/>
            </group>
        </xpath>

        <!-- ========================= -->
        <!-- WOO TAB -->
        <!-- ========================= -->
        <xpath expr="//notebook" position="inside">
            <page string="WooCommerce">
                <group col="4">

                    <group string="Connection">
                        <field name="woo_instance_id"
                               options="{'no_create': True}"
                               placeholder="Select Woo Instance"/>
                    </group>

                    <group string="Sync Info">
                        <field name="woo_product_id" readonly="1"/>
                        <field name="woo_status"/>
                        <field name="woo_last_sync" readonly="1"/>
                    </group>

                </group>
            </page>
        </xpath>


    </field>
</record>

</odoo>
