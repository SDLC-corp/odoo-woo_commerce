<odoo>
    <record id="view_woo_sync_preview_line_list" model="ir.ui.view">
        <field name="name">woo.sync.preview.line.list</field>
        <field name="model">woo.sync.preview.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="record_type"/>
                <field name="woo_id"/>
                <field name="woo_name"/>
                <field name="action_type"/>
                <field name="matched_record"/>
                <field name="would_use_sku_match"/>
                <field name="would_create_mapping"/>
                <field name="would_update_existing"/>
                <field name="message"/>
                <field name="payload_summary"/>
            </list>
        </field>
    </record>

    <record id="view_woo_sync_preview_list" model="ir.ui.view">
        <field name="name">woo.sync.preview.list</field>
        <field name="model">woo.sync.preview</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="source_mode"/>
                <field name="record_type"/>
                <field name="state"/>
                <field name="total_checked"/>
                <field name="would_create_count"/>
                <field name="would_update_count"/>
                <field name="would_skip_count"/>
                <field name="warning_count"/>
                <field name="failure_count"/>
            </list>
        </field>
    </record>

    <record id="view_woo_sync_preview_form" model="ir.ui.view">
        <field name="name">woo.sync.preview.form</field>
        <field name="model">woo.sync.preview</field>
        <field name="arch" type="xml">
            <form string="Dry Run / Preview Sync">
                <header>
                    <button name="action_run_preview"
                            string="Preview Sync"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_proceed_with_actual_sync"
                            string="Proceed With Actual Sync"
                            type="object"
                            class="btn-primary"
                            invisible="not can_proceed"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,failed"/>
                </header>
                <sheet>
                    <widget name="woo_field_help"/>
                    <group col="4">
                        <field name="name"/>
                        <field name="instance_id"/>
                        <field name="source_mode"/>
                        <field name="record_type"/>
                        <field name="woo_id" invisible="source_mode not in ('import_by_id', 'manual_record')"/>
                        <field name="date_filter_type" invisible="source_mode != 'date_range'"/>
                        <field name="date_from" invisible="source_mode != 'date_range'"/>
                        <field name="date_to" invisible="source_mode != 'date_range'"/>
                        <field name="page_size" invisible="source_mode != 'date_range'"/>
                        <field name="update_existing"/>
                    </group>

                    <group string="Summary" col="6">
                        <field name="total_checked" readonly="1"/>
                        <field name="would_create_count" readonly="1"/>
                        <field name="would_update_count" readonly="1"/>
                        <field name="would_skip_count" readonly="1"/>
                        <field name="warning_count" readonly="1"/>
                        <field name="failure_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="summary_message" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Preview Results">
                            <field name="line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="record_type"/>
                                    <field name="woo_id"/>
                                    <field name="woo_name"/>
                                    <field name="action_type"/>
                                    <field name="matched_record"/>
                                    <field name="would_use_sku_match"/>
                                    <field name="would_create_mapping"/>
                                    <field name="would_update_existing"/>
                                    <field name="message"/>
                                    <field name="payload_summary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_sync_preview" model="ir.actions.act_window">
        <field name="name">Preview Sync</field>
        <field name="res_model">woo.sync.preview</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

