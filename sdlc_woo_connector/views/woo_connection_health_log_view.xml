<odoo>
    <record id="woo_connection_health_log_search_view" model="ir.ui.view">
        <field name="name">woo.connection.health.log.search</field>
        <field name="model">woo.connection.health.log</field>
        <field name="arch" type="xml">
            <search string="Connection Health Logs">
                <field name="instance_id"/>
                <field name="check_type"/>
                <field name="status"/>
                <field name="checked_at"/>
                <separator/>
                <filter name="filter_health_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_health_warning" string="Warning" domain="[('status', '=', 'warning')]"/>
                <filter name="filter_health_success" string="Success" domain="[('status', '=', 'success')]"/>
                <separator/>
                <filter name="group_by_instance" string="By Instance" context="{'group_by': 'instance_id'}"/>
                <filter name="group_by_check_type" string="By Check Type" context="{'group_by': 'check_type'}"/>
            </search>
        </field>
    </record>

    <record id="woo_connection_health_log_list_view" model="ir.ui.view">
        <field name="name">woo.connection.health.log.list</field>
        <field name="model">woo.connection.health.log</field>
        <field name="arch" type="xml">
            <list string="Connection Health Logs" create="0" delete="0">
                <field name="checked_at"/>
                <field name="instance_id"/>
                <field name="check_type"/>
                <field name="status"/>
                <field name="response_time_ms"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="woo_connection_health_log_form_view" model="ir.ui.view">
        <field name="name">woo.connection.health.log.form</field>
        <field name="model">woo.connection.health.log</field>
        <field name="arch" type="xml">
            <form string="Connection Health Log" create="0" delete="0" edit="0">
                <sheet>
                    <widget name="woo_field_help"/>
                    <group col="2">
                        <field name="instance_id"/>
                        <field name="checked_at"/>
                        <field name="check_type"/>
                        <field name="status"/>
                        <field name="response_time_ms"/>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                    <group>
                        <field name="details_json" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_connection_health_logs" model="ir.actions.act_window">
        <field name="name">Connection Health Logs</field>
        <field name="res_model">woo.connection.health.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="woo_connection_health_log_search_view"/>
    </record>
</odoo>

