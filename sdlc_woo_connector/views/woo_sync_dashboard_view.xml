<odoo>
    <record id="view_woo_sync_dashboard_form" model="ir.ui.view">
        <field name="name">woo.sync.dashboard.form</field>
        <field name="model">woo.sync.dashboard</field>
        <field name="arch" type="xml">
            <form string="WooCommerce Dashboard" create="0" edit="1" delete="0">
                <header>
                    <button name="action_refresh_dashboard" string="Refresh" type="object" class="btn-secondary"/>
                    <button name="action_run_health_check"
                            string="Run Health Check"
                            type="object"
                            class="btn-primary"
                            invisible="not instance_id"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="instance_id" options="{'no_create_edit': True}"/>
                        <field name="date_filter"/>
                        <field name="date_from" invisible="date_filter != 'custom'"/>
                        <field name="date_to" invisible="date_filter != 'custom'"/>
                    </group>

                    <group string="Sync Overview" col="5">
                        <button name="action_open_sync_reports" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="total_sync_reports" widget="statinfo" string="Total Sync Reports"/>
                        </button>
                        <button name="action_open_sync_reports" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="success_sync_count" widget="statinfo" string="Successful Syncs"/>
                        </button>
                        <button name="action_open_failed_sync_reports" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="failed_sync_count" widget="statinfo" string="Failed Syncs"/>
                        </button>
                        <button name="action_open_running_sync_reports" type="object" class="oe_stat_button" icon="fa-spinner">
                            <field name="running_sync_count" widget="statinfo" string="Pending/Running"/>
                        </button>
                        <button name="action_open_webhook_logs" type="object" class="oe_stat_button" icon="fa-bolt">
                            <field name="webhook_today_count" widget="statinfo" string="Webhook Logs Today"/>
                        </button>
                        <button name="action_open_failed_webhook_logs" type="object" class="oe_stat_button" icon="fa-times-circle">
                            <field name="failed_webhook_count" widget="statinfo" string="Failed Webhooks"/>
                        </button>
                        <button name="action_open_instances" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="active_instance_count" widget="statinfo" string="Active Instances"/>
                        </button>
                    </group>

                    <group string="Queue Monitor" col="4">
                        <button name="action_open_queue_pending" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_queue_count" widget="statinfo" string="Pending Jobs"/>
                        </button>
                        <button name="action_open_queue_running" type="object" class="oe_stat_button" icon="fa-spinner">
                            <field name="running_queue_count" widget="statinfo" string="Running Jobs"/>
                        </button>
                        <button name="action_open_queue_failed" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="failed_queue_count" widget="statinfo" string="Failed Jobs"/>
                        </button>
                        <button name="action_open_retried_today" type="object" class="oe_stat_button" icon="fa-repeat">
                            <field name="retried_jobs_today" widget="statinfo" string="Retried Jobs Today"/>
                        </button>
                        <button name="action_open_queue_monitor" type="object" class="btn-secondary" string="Open Queue Monitor"/>
                    </group>

                    <group string="Connection Snapshot" col="4">
                        <field name="last_health_status" widget="badge" readonly="1"/>
                        <field name="last_response_time_ms" readonly="1"/>
                        <field name="last_sync_date" readonly="1"/>
                        <field name="active_instance_count" readonly="1"/>
                    </group>

                    <group string="Quick Actions" col="4">
                        <button name="action_open_sync_reports" type="object" string="Open Sync Reports" class="btn-secondary"/>
                        <button name="action_open_failed_sync_reports" type="object" string="Open Failed Sync Reports" class="btn-secondary"/>
                        <button name="action_open_webhook_logs" type="object" string="Open Webhook Logs" class="btn-secondary"/>
                        <button name="action_open_failed_webhook_logs" type="object" string="Open Failed Webhook Logs" class="btn-secondary"/>
                        <button name="action_open_health_logs" type="object" string="Open Connection Health Logs" class="btn-secondary"/>
                        <button name="action_open_queue_monitor" type="object" string="Open Queue Monitor" class="btn-secondary"/>
                        <button name="action_open_import_by_id" type="object" string="Open Import by Woo ID" class="btn-secondary"/>
                        <button name="action_open_import_by_date_range" type="object" string="Open Import by Date Range" class="btn-secondary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_sync_dashboard" model="ir.actions.act_window">
        <field name="name">WooCommerce Dashboard</field>
        <field name="res_model">woo.sync.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_woo_sync_dashboard_form"/>
        <field name="target">current</field>
    </record>

    <record id="action_woo_sync_dashboard_open_default" model="ir.actions.server">
        <field name="name">Open WooCommerce Dashboard</field>
        <field name="model_id" ref="model_woo_sync_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_default_dashboard()</field>
    </record>
</odoo>


