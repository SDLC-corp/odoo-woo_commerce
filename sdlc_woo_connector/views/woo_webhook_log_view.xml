<odoo>
    <record id="woo_webhook_log_search_view" model="ir.ui.view">
        <field name="name">woo.webhook.log.search</field>
        <field name="model">woo.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="instance_id"/>
                <field name="topic"/>
                <field name="resource_type"/>
                <field name="woo_id"/>
                <field name="status"/>
                <separator/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_success" string="Success" domain="[('status', '=', 'success')]"/>
                <filter name="filter_today" string="Received Today" domain="[('received_datetime', '>=', context_today())]"/>
                <separator/>
                <filter name="group_instance" string="By Instance" context="{'group_by': 'instance_id'}"/>
                <filter name="group_resource" string="By Resource Type" context="{'group_by': 'resource_type'}"/>
            </search>
        </field>
    </record>

    <record id="woo_webhook_log_list_view" model="ir.ui.view">
        <field name="name">woo.webhook.log.list</field>
        <field name="model">woo.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Webhook Logs" create="0"
                  decoration-danger="status == 'failed'"
                  decoration-success="status == 'success'"
                  decoration-muted="status == 'ignored'">
                <header>
                    <button name="action_simulate_webhook"
                            type="object"
                            string="Simulate Test Webhook"
                            class="btn-secondary"/>
                </header>
                <field name="received_datetime"/>
                <field name="instance_id"/>
                <field name="topic"/>
                <field name="resource_type"/>
                <field name="woo_id"/>
                <field name="status"/>
                <field name="retry_count" optional="show"/>
                <field name="error_message" optional="show"/>
                <button name="action_retry_webhook"
                        type="object"
                        string="Retry"
                        class="btn-link"
                        icon="fa-refresh"
                        invisible="status != 'failed'"/>
                <button name="action_explain_webhook_error_with_ai"
                        type="object"
                        string="Explain with AI"
                        class="btn-link"
                        icon="fa-magic"
                        invisible="status != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="woo_webhook_log_form_view" model="ir.ui.view">
        <field name="name">woo.webhook.log.form</field>
        <field name="model">woo.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Log">
                <header>
                    <button name="action_retry_webhook"
                            type="object"
                            string="Retry Webhook"
                            class="btn-primary"
                            invisible="status != 'failed'"/>
                    <button name="action_explain_webhook_error_with_ai"
                            type="object"
                            string="Explain Webhook Error with AI"
                            class="btn-secondary"
                            invisible="status != 'failed'"/>
                </header>
                <sheet>
                    <widget name="woo_field_help"/>
                    <group col="4">
                        <field name="received_datetime" readonly="1"/>
                        <field name="processed_datetime" readonly="1"/>
                        <field name="instance_id"/>
                        <field name="status"/>
                        <field name="topic"/>
                        <field name="event"/>
                        <field name="resource_type"/>
                        <field name="woo_id"/>
                        <field name="signature_status" readonly="1"/>
                        <field name="retry_count" readonly="1"/>
                        <field name="source_action" readonly="1"/>
                        <field name="related_report_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="error_message" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Headers JSON">
                            <field name="headers_json" widget="text" readonly="1"/>
                        </page>
                        <page string="AI Error Assistant">
                            <group col="2">
                                <field name="ai_last_analyzed_at" readonly="1"/>
                                <field name="ai_retry_recommended" readonly="1"/>
                            </group>
                            <group>
                                <field name="ai_explanation" widget="text" readonly="1"/>
                                <field name="ai_suggested_fix" widget="text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Payload JSON">
                            <field name="payload_json" widget="text" readonly="1"/>
                        </page>
                        <page string="Reports">
                            <field name="webhook_report_ids" readonly="1">
                                <list>
                                    <field name="run_on"/>
                                    <field name="operation"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_webhook_logs" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">woo.webhook.log</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="woo_webhook_log_list_view"/>
        <field name="search_view_id" ref="woo_webhook_log_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No webhook events received yet</p>
            <p>
                Webhook Logs capture every event WooCommerce posts to this Odoo instance
                (product/order/customer/coupon/category created or updated), along with
                date/time, event type, status, and any error message.
            </p>
            <p>
                To see entries here:
            </p>
            <ul>
                <li><strong>Production / staging</strong>: configure WooCommerce webhooks to
                    deliver to <code>&lt;your-odoo-host&gt;/woo/webhook?instance_id=&lt;id&gt;</code>.
                    The fastest way is to open the Instance form and click
                    <em>Register Webhooks</em> &#8212; it creates them for you.</li>
                <li><strong>Reachability check</strong>: open
                    <code>&lt;your-odoo-host&gt;/woo/webhook/ping</code> in a browser. A new
                    row appears here on every hit, proving the route is accessible.</li>
                <li><strong>Local / no public URL</strong>: click
                    <em>Simulate Test Webhook</em> above to insert a sample entry so the page
                    can still be QA-verified.</li>
                <li><strong>Signature verification</strong>: set the same
                    <em>Webhook Secret</em> on the Instance form and in every WooCommerce
                    webhook config. Mismatches show up here with status
                    <em>Failed</em> and <em>signature_status = Invalid</em>.</li>
            </ul>
        </field>
    </record>
</odoo>

