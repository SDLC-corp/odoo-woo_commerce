<odoo>
    <record id="view_woo_manual_record_sync_wizard_form" model="ir.ui.view">
        <field name="name">woo.manual.record.sync.wizard.form</field>
        <field name="model">woo.manual.record.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Woo Instance">
                <sheet>
                    <group>
                        <field name="instance_id" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Continue" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_order_form_woo_manual_sync" model="ir.ui.view">
        <field name="name">sale.order.form.woo.manual.sync</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_manual_import_from_woo"
                        string="Import / Refresh from Woo"
                        type="object"
                        class="btn-secondary"
                        invisible="not woo_order_id"/>
                <button name="action_manual_preview_from_woo"
                        string="Preview Sync"
                        type="object"
                        class="btn-secondary"
                        invisible="not woo_order_id"/>
                <button name="action_manual_export_to_woo"
                        string="Export / Update to Woo"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="WooCommerce Sync">
                    <field name="woo_instance_id"/>
                    <field name="woo_order_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_form_woo_manual_sync" model="ir.ui.view">
        <field name="name">res.partner.form.woo.manual.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="WooCommerce Sync">
                    <group>
                        <field name="woo_instance_id"/>
                        <field name="woo_customer_id"/>
                    </group>
                    <group>
                        <button name="action_manual_import_from_woo"
                                string="Import / Refresh from Woo"
                                type="object"
                                class="btn-secondary"
                                invisible="not woo_customer_id"/>
                        <button name="action_manual_preview_from_woo"
                                string="Preview Sync"
                                type="object"
                                class="btn-secondary"
                                invisible="not woo_customer_id"/>
                        <button name="action_manual_export_to_woo"
                                string="Export / Update to Woo"
                                type="object"
                                class="btn-primary"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_category_form_woo_manual_sync" model="ir.ui.view">
        <field name="name">product.category.form.woo.manual.sync</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="WooCommerce Sync">
                    <group>
                        <field name="woo_instance_id"/>
                        <field name="woo_category_id"/>
                    </group>
                    <group>
                        <button name="action_manual_import_from_woo"
                                string="Import / Refresh from Woo"
                                type="object"
                                class="btn-secondary"
                                invisible="not woo_category_id"/>
                        <button name="action_manual_preview_from_woo"
                                string="Preview Sync"
                                type="object"
                                class="btn-secondary"
                                invisible="not woo_category_id"/>
                        <button name="action_manual_export_to_woo"
                                string="Export / Update to Woo"
                                type="object"
                                class="btn-primary"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
