<odoo>
    <record id="view_woo_import_by_id_wizard_form" model="ir.ui.view">
        <field name="name">woo.import.by.id.wizard.form</field>
        <field name="model">woo.import.by.id.wizard</field>
        <field name="arch" type="xml">
            <form string="Import by Woo ID">
                <sheet>
                    <group>
                        <field name="instance_id" required="1"/>
                        <field name="record_type" required="1"/>
                        <field name="woo_id" required="1"/>
                        <field name="update_existing"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview_sync"
                            string="Preview Sync"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_import_record"
                            string="Import Record"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_woo_import_by_id_wizard" model="ir.actions.act_window">
        <field name="name">Import by Woo ID</field>
        <field name="res_model">woo.import.by.id.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_woo_import_by_id_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
