<odoo>
    <record id="view_woo_inventory_list" model="ir.ui.view">
        <field name="name">woo.inventory.list</field>
        <field name="model">woo.inventory</field>
        <field name="arch" type="xml">
            <list class="o_woo_inventory_list">
                <header>
                    <button name="action_refresh_inventory"
                            type="object"
                            string="Refresh Inventory"
                            class="btn-primary"/>
                </header>
                <field name="product_name" width="280px"/>
                <field name="sku" width="150px"/>
                <field name="quantity" width="200px"/>
                <field name="stock_status" widget="badge"
                       decoration-success="stock_status == 'in_stock'"
                       decoration-danger="stock_status == 'out_of_stock'"
                       width="200px"/>
            </list>
        </field>
    </record>
</odoo>
