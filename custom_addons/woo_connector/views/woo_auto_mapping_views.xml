<odoo>
    <record id="view_woo_auto_mapping_list" model="ir.ui.view">
        <field name="name">woo.auto.mapping.list</field>
        <field name="model">woo.auto.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="instance_id"/>
                <field name="mapping_type"/>
                <field name="woo_label"/>
                <field name="woo_key"/>
                <field name="odoo_model"/>
                <field name="odoo_display_name"/>
                <field name="auto_created"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_woo_auto_mapping_form" model="ir.ui.view">
        <field name="name">woo.auto.mapping.form</field>
        <field name="model">woo.auto.mapping</field>
        <field name="arch" type="xml">
            <form string="Woo Auto Mapping">
                <sheet>
                    <group col="2">
                        <field name="instance_id"/>
                        <field name="mapping_type"/>
                        <field name="woo_label"/>
                        <field name="woo_key"/>
                        <field name="odoo_model"/>
                        <field name="odoo_res_id"/>
                        <field name="odoo_value"/>
                        <field name="odoo_display_name" readonly="1"/>
                        <field name="auto_created"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_woo_auto_mapping_search" model="ir.ui.view">
        <field name="name">woo.auto.mapping.search</field>
        <field name="model">woo.auto.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="instance_id"/>
                <field name="mapping_type"/>
                <field name="woo_label"/>
                <field name="woo_key"/>
                <filter name="auto_created" string="Auto Created" domain="[('auto_created', '=', True)]"/>
                <filter name="manual_created" string="Manual" domain="[('auto_created', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_woo_auto_mapping" model="ir.actions.act_window">
        <field name="name">Auto Mappings</field>
        <field name="res_model">woo.auto.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_woo_auto_mapping_search"/>
    </record>
</odoo>
