<odoo>

    <!-- LIST VIEW -->
    <record id="woo_report_list_view" model="ir.ui.view">
        <field name="name">woo.report.list</field>
        <field name="model">woo.report</field>
        <field name="arch" type="xml">
            <list string="WooCommerce Sync Reports">
                <button name="action_retry_sync"
                        type="object"
                        string="Retry Sync"
                        class="btn-primary"
                        invisible="status != 'failed'"/>
                <button name="action_explain_error_with_ai"
                        type="object"
                        string="Explain Error with AI"
                        class="btn-secondary"
                        invisible="status != 'failed'"/>
                <field name="create_date"/>
                <field name="instance_id"/>
                <field name="operation"/>
                <field name="mode"/>
                <field name="source_action"/>
                <field name="sync_direction"/>
                <field name="woo_id"/>
                <field name="status"/>
                <field name="retry_count"/>
                <field name="last_retry_date"/>
                <field name="run_on"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="woo_report_form_view" model="ir.ui.view">
        <field name="name">woo.report.form</field>
        <field name="model">woo.report</field>
        <field name="arch" type="xml">
            <form string="WooCommerce Sync Report">
                <header>
                    <button name="action_open_webhook_log"
                            string="Webhook Log"
                            type="object"
                            class="btn-secondary"
                            invisible="not webhook_log_id"/>
                    <button name="action_explain_error_with_ai"
                            string="Explain Error with AI"
                            type="object"
                            class="btn-secondary"
                            invisible="status != 'failed'"/>
                    <button name="action_retry_sync"
                            string="Retry Sync"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'failed'"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="instance_id"/>
                        <field name="operation"/>
                        <field name="operation_type" readonly="1"/>
                        <field name="mode"/>
                        <field name="sync_direction" readonly="1"/>
                        <field name="source_action"/>
                        <field name="reference"/>
                        <field name="woo_id" readonly="1"/>
                        <field name="webhook_log_id" readonly="1"/>
                        <field name="status"/>
                        <field name="retry_count" readonly="1"/>
                        <field name="last_retry_date" readonly="1"/>
                        <field name="run_on"/>
                    </group>
                    <group col="2">
                        <field name="message"/>
                        <field name="error_message" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" widget="text" readonly="1"/>
                        </page>
                        <page string="AI Error Assistant">
                            <group col="2">
                                <field name="ai_last_analyzed_at" readonly="1"/>
                                <field name="ai_retry_recommended" readonly="1"/>
                            </group>
                            <group>
                                <field name="ai_explanation" widget="text" readonly="1"/>
                                <field name="ai_suggested_fix" widget="text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="source_action"/>
                                    <field name="record_type"/>
                                    <field name="woo_id"/>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_woo_sync_reports" model="ir.actions.act_window">
        <field name="name">Sync Reports</field>
        <field name="res_model">woo.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('has_webhook', '=', False)]</field>
    </record>

    <record id="action_woo_webhook_reports" model="ir.actions.act_window">
        <field name="name">Webhook Reports</field>
        <field name="res_model">woo.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('has_webhook', '=', True)]</field>
    </record>

</odoo>
