<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_test_module_tree" model="ir.ui.view">
        <field name="name">custom.test.module.tree</field>
        <field name="model">custom.test.module</field>
        <field name="arch" type="xml">
            <list string="Custom Test Records">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_custom_test_module_form" model="ir.ui.view">
        <field name="name">custom.test.module.form</field>
        <field name="model">custom.test.module</field>
        <field name="arch" type="xml">
            <form string="Custom Test Record">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custom_test_module" model="ir.actions.act_window">
        <field name="name">Custom Test Module</field>
        <field name="res_model">custom.test.module</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_custom_test_module_root" name="Custom Test" sequence="10"/>
    <menuitem id="menu_custom_test_module" name="Records" parent="menu_custom_test_module_root" action="action_custom_test_module" sequence="20"/>
</odoo>
